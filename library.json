{
  "name": "OttoFlow",
  "version": "0.1.0",
  "description": "Rapid-development framework for Otto DIY robots: expressive facades (Mouth, Eyes, Legs) over hardware modules, zero-config kit presets, unit-explicit names, full low-level access. Wraps OttoDIYLib.",
  "keywords": ["otto", "ottodiy", "robot", "biped", "humanoid", "framework", "servo", "hc-sr04", "max7219"],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmeddabak/OttoFlow.git"
  },
  "frameworks": "arduino",
  "platforms": "atmelavr",
  "headers": ["OttoFlow.h", "OttoFlowDriver.h"],
  "dependencies": [
    { "name": "OttoDIYLib", "version": "https://github.com/OttoDIY/OttoDIYLib.git" },
    { "owner": "arduino-libraries", "name": "Servo", "version": "^1.2.0" }
  ],
  "export": {
    "exclude": [".pio", ".idea"]
  }
}
